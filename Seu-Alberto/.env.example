# Configure com os endereços oficiais do abrigo; links sem valor não são ativados.
VITE_INSTAGRAM_URL=
VITE_WHATSAPP_URL=
VITE_CONTACT_EMAIL=

# --- Backend (Vercel Functions) — configure em Project Settings > Environment Variables ---
# Upstash Redis (Vercel Marketplace > Upstash > Redis): preenche KV_REST_API_URL e KV_REST_API_TOKEN
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Vercel Blob (Storage > Blob): preenche BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=
# Admin: hash bcrypt da senha (node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 12))")
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Segredo com 32+ caracteres para assinar a sessão (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# E-mail do abrigo via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=
